# Copy to .env and adjust. CLI flags take precedence over these values.

# auto | cuda | cpu  (auto uses CUDA when available, otherwise CPU)
TTS_DEVICE=auto
# What voice="default" resolves to
TTS_DEFAULT_VOICE=af_heart
# 0.5 - 2.0 (1.0 reads at about 177 words per minute; 0.85 gives about 150)
TTS_DEFAULT_SPEED=1.0
# Used when --output is not given
TTS_OUTPUT_DIR=outputs
# Maximum characters per synthesis chunk (at least 50)
TTS_MAX_CHUNK_CHARS=400
# Silence between chunks / at paragraph breaks (milliseconds)
TTS_SENTENCE_PAUSE_MS=250
TTS_PARAGRAPH_PAUSE_MS=700
# Retries per failed chunk, then skip | abort
TTS_CHUNK_RETRIES=1
TTS_ON_CHUNK_ERROR=skip
# Path to the pronunciation dictionary (optional), e.g. pronunciations.txt
TTS_PRONUNCIATIONS=
# Fix numbers/abbreviations Kokoro misreads (Main St., 3:30 pm, 5 km, 1-10, Henry VIII): true | false
TTS_NORMALIZE=true
# Write an .srt next to the audio: true | false
TTS_SUBTITLES=true
# DEBUG | INFO | WARNING | ERROR
TTS_LOG_LEVEL=INFO

# Voice cloning (needs `uv sync --extra clone`). A 5+ s clip of clean speech (.wav/.flac/.mp3/.ogg);
# when set, Chatterbox speaks in that voice instead of Kokoro. Leave empty to use Kokoro.
TTS_VOICE_SAMPLE=
# How expressive the cloned voice is: 0.25 - 2.0 (0.5 neutral, 0.7+ dramatic/cartoony)
TTS_EXAGGERATION=0.5
# How closely it follows the sample's pacing: 0 - 1 (lower = slower, more deliberate)
TTS_CFG_WEIGHT=0.5
# A fixed seed (0 - 4294967295) repeats the cloned voice's takes exactly; empty = random each run
TTS_SEED=

# Standard Hugging Face variables
# HF_HOME=D:\hf-cache
# Set to 1 to forbid network access once the model is cached
# HF_HUB_OFFLINE=1
