# Copy to .env and adjust. CLI flags take precedence over these values.

# auto | cuda | cpu  (auto uses CUDA when available, otherwise CPU)
TTS_DEVICE=auto
# What voice="default" resolves to
TTS_DEFAULT_VOICE=af_heart
# 0.5 - 2.0
TTS_DEFAULT_SPEED=1.0
# Used when --output is not given
TTS_OUTPUT_DIR=outputs
# Maximum characters per synthesis chunk
TTS_MAX_CHUNK_CHARS=400
# Silence between chunks / at paragraph breaks (milliseconds)
TTS_SENTENCE_PAUSE_MS=250
TTS_PARAGRAPH_PAUSE_MS=700
# Retries per failed chunk, then skip | abort
TTS_CHUNK_RETRIES=1
TTS_ON_CHUNK_ERROR=skip
# Path to the pronunciation dictionary (optional)
TTS_PRONUNCIATIONS=
# Write an .srt next to the audio: true | false
TTS_SUBTITLES=true
# DEBUG | INFO | WARNING | ERROR
TTS_LOG_LEVEL=INFO

# Standard Hugging Face variables
# HF_HOME=D:\hf-cache
# Set to 1 to forbid network access once the model is cached
# HF_HUB_OFFLINE=1
